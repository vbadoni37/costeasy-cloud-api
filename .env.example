# ─────────────────────────────────────────────
#  CostEasy Cloud — Backend Environment Config
#  Copy this to .env and fill in your values
# ─────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# JWT Secret (keep this private and complex)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS

# Supabase
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Admin for key generation (you only — keep secret)
ADMIN_PASSWORD=your_admin_password_here

# SMTP for sending license keys via email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=blvttech@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=CostEasy Licensing <blvttech@gmail.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
